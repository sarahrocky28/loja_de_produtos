        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    usuarios ||--o{ enderecos : possui\n    usuarios ||--o{ pedidos : realiza\n    usuarios ||--o{ carrinho_itens : mantem\n    enderecos ||--o{ pedidos : entrega\n    cupons |o--o{ pedidos : aplicado_em\n    categorias ||--o{ produtos : classifica\n    produtos ||--o{ itens_pedido : aparece_em\n    produtos ||--o{ carrinho_itens : esta_em\n    pedidos ||--|{ itens_pedido : contem\n    usuarios {\n        INTEGER id_usuario PK\n        TEXT nome\n        TEXT email UK\n        TEXT senha_hash\n        TEXT perfil\n    }\n    enderecos {\n        INTEGER id_endereco PK\n        INTEGER id_usuario FK\n        TEXT cep\n        TEXT logradouro\n    }\n    categorias {\n        INTEGER id_categoria PK\n        TEXT nome UK\n    }\n    produtos {\n        INTEGER id_produto PK\n        INTEGER id_categoria FK\n        TEXT nome\n        INTEGER preco\n        INTEGER estoque\n        INTEGER ativo\n    }\n    cupons {\n        INTEGER id_cupom PK\n        TEXT codigo UK\n        TEXT tipo_desconto\n        INTEGER valor_desconto\n        TEXT validade\n        INTEGER ativo\n    }\n    pedidos {\n        INTEGER id_pedido PK\n        INTEGER id_usuario FK\n        INTEGER id_endereco FK\n        INTEGER id_cupom FK\n        INTEGER subtotal\n        INTEGER desconto\n        INTEGER frete\n        INTEGER total\n        TEXT forma_pagamento\n        TEXT status\n    }\n    itens_pedido {\n        INTEGER id_item PK\n        INTEGER id_pedido FK\n        INTEGER id_produto FK\n        INTEGER quantidade\n        INTEGER preco_unitario\n    }\n    carrinho_itens {\n        INTEGER id_usuario FK\n        INTEGER id_produto FK\n        INTEGER quantidade\n    }\n    regioes_frete {\n        INTEGER id_regiao PK\n        TEXT cep_inicio\n        TEXT cep_fim\n        INTEGER valor_base\n        INTEGER prazo_dias\n        INTEGER frete_gratis\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bE88Tp2llxn6jffTqhpA-1">
