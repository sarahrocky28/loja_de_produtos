# Copie este arquivo para ".env" e preencha
PORT=3001
JWT_SECRET=troque-por-uma-frase-longa-e-secreta
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Frete fixo (em centavos): 1990 = R$ 19,90
FRETE_FIXO=1990
# Frete grátis para compras acima de (em centavos): 21500 = R$ 215,00
FRETE_GRATIS_ACIMA=21500
PRAZO_ENTREGA_DIAS=7
# Entrega expressa: valor em centavos (3490 = R$ 34,90) e prazo em dias
FRETE_EXPRESSO=3490
PRAZO_EXPRESSO=3

# Mercado Pago: pegue em https://www.mercadopago.com.br/developers (Suas integrações > Credenciais)
MERCADOPAGO_ACCESS_TOKEN=

# E-mail para o "esqueci a senha" (opcional). Sem isso, o link aparece só no terminal do back.
# Exemplo com Gmail: ative a verificação em duas etapas e crie uma "senha de app" na conta Google.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
